# Admin service environment. Copy to .env.prod in the main checkout, then run
# `just install-prod-env`. Keep .env.prod private; never commit it.
TABQUEST_DATABASE_URL=libsql://<db>-<org>.turso.io
TABQUEST_DATABASE_AUTH_TOKEN=<admin write token>
# Used by `just update-prod` to check images without the admin write token.
TABQUEST_TURSO_READONLY_TOKEN=<read-only token>
# Optional receipt OCR. Leave blank to disable it.
VISION_API_TOKEN=
