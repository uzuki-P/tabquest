# Copy this file to .env.local in each development worktree.
# Do not copy it to the production main checkout.
# Run `just db-pull` before `just dev`; both dev runtimes use this local copy.
TABQUEST_DATABASE_URL=file:./data/tabquest-turso.db
TABQUEST_UPLOAD_DIR=./data/uploads

# Read-only Turso credentials for `just db-pull` and image checks.
TABQUEST_TURSO_URL=libsql://<db>-<org>.turso.io
TABQUEST_TURSO_READONLY_TOKEN=<read-only token>

# Optional OCR during local development. Leave the URL or token blank to disable it.
VISION_API_TOKEN=
VISION_API_URL=
VISION_API_MODEL=zai-coding-plan/glm-5.3-flash
VISION_API_REASONING_EFFORT=low
VISION_API_TIMEOUT_MS=150000

# Production admin credentials go in the main checkout's .env.prod;
# `just install-prod-env` copies them to ~/.config/tabquest/admin.env.
# Public runtime credentials belong in the Vercel project environment.
