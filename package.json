{
  "name": "tabquest",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --host 127.0.0.1 --port 46533 --strictPort",
    "dev:public": "TABQUEST_RUNTIME=public bun --bun vite dev --host 127.0.0.1 --port 46534 --strictPort",
    "dev:admin": "bun --bun vite dev --host 127.0.0.1 --port 46533 --strictPort",
    "build": "bun --bun vite build",
    "build:vercel": "TABQUEST_TARGET=vercel bun --bun vite build",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "start": "bun run scripts/serve.ts",
    "start:public": "TABQUEST_RUNTIME=public TABQUEST_PORT=48781 bun run scripts/serve.ts",
    "start:admin": "TABQUEST_RUNTIME=admin TABQUEST_PORT=54096 bun run scripts/serve.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-plugin": "^1.168.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "effect": "^4.0.1",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "nitro": "^3.0.260903-beta",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "vercel": "^62.4.0",
    "vite": "^8.3.2"
  }
}
